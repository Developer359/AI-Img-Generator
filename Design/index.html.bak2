<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>CREATIVE STUDIO AI - Image Generation Studio</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: { sans: ['Inter', 'sans-serif'] },
        colors: {
          midnight: '#0B0D14',
          surface: { card: '#161922', input: '#1C212D', border: 'rgba(255,255,255,0.08)', active: '#232938' },
          accent: { purple: '#8434E7', hover: '#9549f5', glow: 'rgba(132,52,231,0.35)' }
        }
      }
    }
  }
</script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100vh; overflow: hidden; }
  ::-webkit-scrollbar { width: 4px; height: 4px; }
  ::-webkit-scrollbar-track { background: #0B0D14; }
  ::-webkit-scrollbar-thumb { background: #272C3D; border-radius: 9999px; }
  ::-webkit-scrollbar-thumb:hover { background: #3B425B; }
  .bg-ambient-radial {
    background: radial-gradient(circle at 50% 15%, rgba(132,52,231,0.07) 0%, transparent 60%);
  }
  .ratio-grid {
    display: grid;
    margin-top: 5px;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    min-height: 0;
  }
  .ratio-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.02);
    cursor: pointer;
    transition: all 0.15s;
    padding: 6px 4px;
    text-align: center;
    min-height: 0;
  }
  .ratio-btn:hover { border-color: rgba(255,255,255,0.15); background: rgba(255,255,255,0.04); }
  .ratio-btn.active {
    border-color: rgba(168,85,247,0.6);
    background: rgba(88,28,135,0.2);
    box-shadow: 0 0 15px -3px rgba(168,85,247,0.2);
  }
  .ratio-shape {
    border-radius: 3px;
    background: rgba(100,116,139,0.3);
    border: 1px solid rgba(100,116,139,0.4);
    margin-bottom: 5px;
  }
  .ratio-btn.active .ratio-shape {
    background: rgba(192,132,252,0.25);
    border: 2px solid rgb(192,132,252);
  }

  /* Spinning loader ring */
  @keyframes spin-ring {
    to { transform: rotate(360deg); }
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 18px 4px rgba(132,52,231,0.25); }
    50%       { box-shadow: 0 0 36px 10px rgba(132,52,231,0.55); }
  }
  @keyframes dots {
    0%   { content: ''; }
    33%  { content: '.'; }
    66%  { content: '..'; }
    100% { content: '...'; }
  }
  .loader-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2.5px solid transparent;
    border-top-color: rgba(168,85,247,0.9);
    border-right-color: rgba(99,102,241,0.5);
    animation: spin-ring 1.1s linear infinite;
  }
  .loader-ring-outer {
    position: absolute;
    inset: -18px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    border-bottom-color: rgba(168,85,247,0.3);
    animation: spin-ring 2.3s linear infinite reverse;
  }
  .canvas-waiting {
    animation: pulse-glow 2s ease-in-out infinite;
  }
  .ellipsis::after {
    content: '';
    animation: dots 1.5s steps(3, end) infinite;
  }
  /* Shimmer bar */
  @keyframes shimmer {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  .shimmer-bar {
    position: relative;
    overflow: hidden;
    height: 3px;
    border-radius: 9999px;
    background: rgba(255,255,255,0.06);
    width: 180px;
    margin-top: 18px;
  }
  .shimmer-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(168,85,247,0.8) 50%, transparent 100%);
    animation: shimmer 1.6s ease-in-out infinite;
  }
</style>
</head>
<body class="bg-[#090B10] text-slate-200 font-sans selection:bg-purple-600 selection:text-white" style="display:flex;flex-direction:column;height:100vh;overflow:hidden;">

<!-- FIXED HEADER -->
<header style="position:fixed;top:0;left:0;right:0;height:56px;z-index:50;flex-shrink:0;" class="border-b border-white/[0.08] bg-[#0E1118]/90 backdrop-blur-md px-5 flex items-center">
  <div class="flex items-center space-x-3">
    <!-- Original logo icon restored -->
    <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-purple-600/80 to-indigo-500/80 p-[1px] flex items-center justify-center shadow-lg shadow-purple-600/20">
      <div class="w-full h-full bg-[#0D1017] rounded-[9px] flex items-center justify-center">
        <span class="material-symbols-outlined text-purple-400" style="font-size:14px;">auto_awesome</span>
      </div>
    </div>
    <div class="flex items-baseline space-x-1">
      <span class="text-[16px] font-semibold tracking-tight text-white">Studio</span>
      <span class="text-[16px] font-medium text-slate-400">AI</span>
    </div>
    <!-- Model name pill -->
    <div class="flex items-center ml-18 space-x-1.5 px-2.5 py-1 rounded-full bg-white/[0.03] border border-white/[0.08] text-xs text-slate-300 hover:border-white/20 transition cursor-pointer">
      <span class="font-medium text-slate-200" style="font-size:11px;">Lykon/dreamshaper-xl-v2-turbo</span>
    </div>
  </div>
</header>

<!-- MAIN CONTENT — fixed below header, fills remaining viewport -->
<main class="bg-ambient-radial" style="position:fixed;top:56px;left:0;right:0;bottom:0;display:flex;padding:40px;gap:15px;overflow:hidden;padding-left: 60px;padding-right: 80px;">

  <!-- Control Panel (Left Column) -->
  <aside style="width:390px;min-width:390px;display:flex;flex-direction:column;overflow:hidden;" class="bg-[#121620] border border-white/[0.08] rounded-2xl shadow-2xl backdrop-blur-sm" style2="padding:16px;">
    <div style="flex:1;display:flex;flex-direction:column;padding:14px 16px 0 16px;overflow:hidden;min-height:0;gap:10px;">

      <!-- Prompt Section -->
      <div style="flex-shrink:0;">
        <div class="flex items-center justify-between" style="margin-bottom:6px;">
          <label class="flex items-center space-x-1" for="prompt-input" style="font-size:15px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:rgb(203,213,225);">
            <span class="material-symbols-outlined text-purple-400" style="font-size:13px;">edit_note</span>
            <span>Prompt</span>
          </label>
          <button id="btn-surprise" type="button" class="flex items-center space-x-1 hover:text-slate-200 transition" style="font-size:10px;color:rgb(148,163,184);">
            <span class="material-symbols-outlined" style="font-size:13px;">casino</span>
            <span>Surprise Me</span>
          </button>
        </div>
        <div class="rounded-xl bg-gradient-to-b from-white/[0.04] to-transparent p-[1px]">
          <div class="bg-[#0F131D] rounded-xl border border-white/[0.08] focus-within:border-purple-500/80 focus-within:ring-1 focus-within:ring-purple-500/40 transition" style="padding:18px 10px;">
            <textarea
              id="prompt-input"
              class="w-full bg-transparent border-0 p-0 text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-0 resize-none leading-relaxed"
              style="font-size:12px;min-height:90px;"
              placeholder="A cinematic shot of a neon cyberpunk monolith in dense misty rain, dramatic rim lighting, photorealistic 8k..."
              oninput="updateCharCount(this)"></textarea>
            <div class="border-t border-white/[0.05] flex items-center justify-between" style="padding-top:6px;margin-top:6px;">
              <span id="char-count" style="font-size:10px;color:rgb(100,116,139);">0 / 1000 characters</span>
              <button type="button" class="flex items-center space-x-1 hover:text-slate-300 transition" style="font-size:10px;color:rgb(100,116,139);">
                <span class="material-symbols-outlined" style="font-size:12px;">tune</span>
                <span>Negative</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Aspect Ratio Section -->
      <div style="flex:1;display:flex;flex-direction:column;min-height:0; margin-top: 16px;">
        <div class="flex items-center justify-between" style="margin-bottom:6px;flex-shrink:0;">
          <label class="flex items-center space-x-1" style="font-size:15px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:rgb(203,213,225);">
            <span class="material-symbols-outlined text-purple-400" style="font-size:13px;">aspect_ratio</span>
            <span>Aspect Ratio</span>
          </label>
          <span style="font-size:10px;color:rgb(100,116,139);">Select canvas shape</span>
        </div>

        <div class="ratio-grid" role="radiogroup" aria-label="Aspect Ratio Selection">
          <!-- 1:1 Square (active) -->
          <button type="button" role="radio" aria-checked="true" class="ratio-btn active" data-ratio="1:1 Square">
            <div class="ratio-shape" style="width:16px;height:16px;"></div>
            <span style="font-size:10px;font-weight:500;color:rgb(241,245,249);">1:1 Square</span>
            <span style="font-size:9px;color:rgba(216,180,254,0.8);margin-top:1px;">1024 × 1024</span>
          </button>
          <!-- 16:9 Wide -->
          <button type="button" role="radio" aria-checked="false" class="ratio-btn" data-ratio="16:9 Wide">
            <div class="ratio-shape" style="width:22px;height:13px;"></div>
            <span style="font-size:10px;font-weight:500;color:rgb(148,163,184);">16:9 Wide</span>
            <span style="font-size:9px;color:rgb(100,116,139);margin-top:1px;">1920 × 1080</span>
          </button>
          <!-- 4:3 Classic -->
          <button type="button" role="radio" aria-checked="false" class="ratio-btn" data-ratio="4:3 Classic">
            <div class="ratio-shape" style="width:19px;height:14px;"></div>
            <span style="font-size:10px;font-weight:500;color:rgb(148,163,184);">4:3 Classic</span>
            <span style="font-size:9px;color:rgb(100,116,139);margin-top:1px;">1440 × 1080</span>
          </button>
          <!-- 3:4 Portrait -->
          <button type="button" role="radio" aria-checked="false" class="ratio-btn" data-ratio="3:4 Portrait">
            <div class="ratio-shape" style="width:13px;height:17px;"></div>
            <span style="font-size:10px;font-weight:500;color:rgb(148,163,184);">3:4 Portrait</span>
            <span style="font-size:9px;color:rgb(100,116,139);margin-top:1px;">1080 × 1440</span>
          </button>
          <!-- 9:16 Story -->
          <button type="button" role="radio" aria-checked="false" class="ratio-btn" data-ratio="9:16 Story">
            <div class="ratio-shape" style="width:11px;height:20px;"></div>
            <span style="font-size:10px;font-weight:500;color:rgb(148,163,184);">9:16 Story</span>
            <span style="font-size:9px;color:rgb(100,116,139);margin-top:1px;">1080 × 1920</span>
          </button>
          <!-- 21:9 Cinema -->
          <button type="button" role="radio" aria-checked="false" class="ratio-btn" data-ratio="21:9 Cinema">
            <div class="ratio-shape" style="width:24px;height:10px;"></div>
            <span style="font-size:10px;font-weight:500;color:rgb(148,163,184);">21:9 Cinema</span>
            <span style="font-size:9px;color:rgb(100,116,139);margin-top:1px;">2560 × 1080</span>
          </button>
        </div>
      </div>

    </div>

    <!-- Generate Button — pinned to bottom inside padding -->
    <div style="padding:10px 16px 14px 16px;flex-shrink:0;border-top:1px solid rgba(255,255,255,0.06);margin-top:10px;">
      <button id="btn-generate" type="button"
        class="w-full rounded-xl bg-gradient-to-r from-purple-600 via-indigo-600 to-purple-600 hover:from-purple-500 hover:to-indigo-500 active:scale-[0.99] text-white font-medium shadow-lg shadow-purple-600/25 border border-purple-400/30 hover:border-purple-300/50 transition-all duration-200 flex items-center justify-between group"
        style="padding:11px 18px;font-size:13px;">
        <span class="flex items-center space-x-2">
          <span id="gen-icon" class="material-symbols-outlined" style="font-size:16px;">auto_awesome</span>
          <span id="gen-label" class="tracking-wide">Generate</span>
        </span>
        <span class="flex items-center space-x-1 px-2 py-0.5 rounded-md bg-black/30 border border-white/10 text-purple-200/90 group-hover:bg-black/40 transition" style="font-size:10px;">
          <span>⌘</span>
          <span>Enter</span>
        </span>
      </button>
    </div>
  </aside>

  <!-- Canvas Preview Panel (Right Column) -->
  <section id="canvas-section" style="flex:1;position:relative;overflow:hidden;" class="bg-[#121620] border border-white/[0.08] rounded-2xl flex flex-col items-center justify-center shadow-2xl">

    <!-- Placeholder state (shown when no image yet) -->
    <div id="canvas-placeholder" class="flex flex-col items-center justify-center text-center select-none" style="max-width:360px;padding:0 24px;">
      <!-- Icon wrapper with optional spinning rings -->
      <div class="relative flex items-center justify-center" style="width:120px;height:120px;margin-bottom:22px;">
        <div class="absolute inset-0 rounded-full" style="background:rgba(124,58,237,0.1);filter:blur(28px);"></div>
        <!-- Outer spinning ring (hidden by default, shown when waiting) -->
        <div id="ring-outer" class="loader-ring-outer" style="display:none;"></div>
        <!-- Inner spinning ring (hidden by default, shown when waiting) -->
        <div id="ring-inner" class="loader-ring" style="display:none;"></div>
        <div id="canvas-icon-wrap" class="relative flex items-center justify-center rounded-2xl border border-white/[0.08] shadow-2xl" style="width:72px;height:72px;background:rgba(255,255,255,0.03);">
          <span id="canvas-icon" class="material-symbols-outlined text-purple-400/80 animate-pulse" style="font-size:32px;">view_in_ar</span>
        </div>
      </div>
      <h3 id="canvas-title" class="font-semibold text-white tracking-tight" style="font-size:15px;margin-bottom:8px;">Ready to create</h3>
      <p id="canvas-msg" class="text-slate-400 font-normal leading-relaxed" style="font-size:12px;margin-bottom:4px;">Describe your vision in the prompt field and choose your preferred aspect ratio to generate artwork.</p>
      <!-- Time hint — shown only when waiting for Kaggle -->
      <p id="canvas-time-hint" style="display:none;font-size:11px;color:rgba(168,85,247,0.85);margin-bottom:4px;font-weight:500;">⏱ Takes about 1–2 minutes on Kaggle GPU</p>
      <!-- Shimmer progress bar — shown only when waiting -->
      <div id="canvas-shimmer" class="shimmer-bar" style="display:none;"></div>
      <div class="flex items-center space-x-2" style="font-size:11px;color:rgb(100,116,139);margin-top:18px;">
        <span class="px-2.5 py-1 rounded-full border border-white/[0.06]" style="background:rgba(255,255,255,0.03);">High Resolution</span>
        <span class="px-2.5 py-1 rounded-full border border-white/[0.06]" style="background:rgba(255,255,255,0.03);">Kaggle GPU</span>
      </div>
    </div>

    <!-- Generated image state (hidden until image is ready) -->
    <div id="canvas-image-wrap" style="display:none;width:100%;height:100%;position:relative;flex-direction:column;padding:14px;gap:12px;">
      <img id="canvas-image" src="" alt="Generated image"
        onerror="this.onerror=null; showPlaceholder('Image failed to load', 'Press Fetch Image to try again.', 'broken_image', false, false);"
        style="flex:1;min-height:0;width:100%;object-fit:contain;border-radius:14px;" />
      <!-- Download button (below the image) -->
      <div style="display:flex;justify-content:center;flex-shrink:0;">
        <a id="btn-download" href="#" download
          class="flex items-center space-x-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-medium border border-purple-400/30 shadow-lg shadow-purple-600/25 transition-all"
          style="padding:9px 20px;font-size:12px;text-decoration:none;">
          <span class="material-symbols-outlined" style="font-size:16px;">download</span>
          <span>Download Image</span>
        </a>
      </div>
    </div>

    <!-- Bottom toolbar -->
    <div class="absolute flex items-center space-x-1.5 border border-white/[0.08] rounded-xl shadow-xl" style="bottom:16px;right:20px;background:rgba(18,22,34,0.9);backdrop-filter:blur(12px);padding:5px 10px;font-size:11px;color:rgb(148,163,184);">
      <button class="px-2 py-0.5 rounded hover:bg-white/[0.05] hover:text-slate-200 transition font-medium" style="font-size:10px;" title="Reset Zoom">Fit Screen</button>
      <span style="color:rgb(51,65,85);">|</span>
      <!-- Fetch Image button: downloads latest Kaggle output immediately -->
      <button id="btn-fetch" onclick="fetchImageNow()" class="flex items-center space-x-1 px-2 py-0.5 rounded hover:bg-purple-500/20 hover:text-purple-300 transition" title="Download latest Kaggle output now" style="font-size:10px;color:rgb(168,85,247);">
        <span class="material-symbols-outlined" style="font-size:13px;">download</span>
        <span>Fetch Image</span>
      </button>
      <span style="color:rgb(51,65,85);">|</span>
      <button class="px-1 py-0.5 rounded hover:bg-white/[0.05] hover:text-slate-200 transition flex items-center" title="Fullscreen">
        <span class="material-symbols-outlined" style="font-size:14px;">fullscreen</span>
      </button>
    </div>
  </section>

</main>

<script>
  // ── Aspect ratio toggle ───────────────────────────────────────────────
  let selectedRatio = '1:1 Square';
  const ratioButtons = document.querySelectorAll('.ratio-btn');
  ratioButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      ratioButtons.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-checked', 'false');
        const label = b.querySelector('span:nth-child(2)');
        if (label) label.style.color = 'rgb(148,163,184)';
        const sub = b.querySelector('span:nth-child(3)');
        if (sub) sub.style.color = 'rgb(100,116,139)';
      });
      btn.classList.add('active');
      btn.setAttribute('aria-checked', 'true');
      const label = btn.querySelector('span:nth-child(2)');
      if (label) label.style.color = 'rgb(241,245,249)';
      const sub = btn.querySelector('span:nth-child(3)');
      if (sub) sub.style.color = 'rgba(216,180,254,0.8)';
      selectedRatio = btn.dataset.ratio || '1:1 Square';
    });
  });

  // ── Character counter ─────────────────────────────────────────────────
  function updateCharCount(ta) {
    const len = ta.value.length;
    document.getElementById('char-count').textContent = len + ' / 1000 characters';
    if (len > 1000) ta.value = ta.value.slice(0, 1000);
  }

  // ── Surprise Me ───────────────────────────────────────────────────────
  document.getElementById('btn-surprise').addEventListener('click', async () => {
    try {
      const res = await fetch('/surprise');
      const data = await res.json();
      const ta = document.getElementById('prompt-input');
      ta.value = data.prompt;
      updateCharCount(ta);
    } catch(e) { console.warn('Surprise failed:', e); }
  });

  // ── Canvas state helpers ──────────────────────────────────────────────
  function showPlaceholder(title, msg, icon = 'view_in_ar', pulse = false, waiting = false) {
    document.getElementById('canvas-image-wrap').style.display = 'none';
    document.getElementById('canvas-placeholder').style.display = 'flex';
    document.getElementById('canvas-title').textContent = title;
    document.getElementById('canvas-msg').textContent   = msg;
    const ic = document.getElementById('canvas-icon');
    ic.textContent = icon;
    ic.className = 'material-symbols-outlined text-purple-400/80' + (pulse ? ' animate-pulse' : '');
    ic.style.fontSize = '32px';
    const ringInner = document.getElementById('ring-inner');
    const ringOuter = document.getElementById('ring-outer');
    const timeHint  = document.getElementById('canvas-time-hint');
    const shimmer   = document.getElementById('canvas-shimmer');
    const iconWrap  = document.getElementById('canvas-icon-wrap');
    if (waiting) {
      ringInner.style.display = 'block';
      ringOuter.style.display = 'block';
      timeHint.style.display  = 'block';
      shimmer.style.display   = 'block';
      iconWrap.classList.add('canvas-waiting');
    } else {
      ringInner.style.display = 'none';
      ringOuter.style.display = 'none';
      timeHint.style.display  = 'none';
      shimmer.style.display   = 'none';
      iconWrap.classList.remove('canvas-waiting');
    }
  }

  function showImage(src) {
    document.getElementById('canvas-placeholder').style.display = 'none';
    const wrap = document.getElementById('canvas-image-wrap');
    const img  = document.getElementById('canvas-image');
    img.src = src + (src.includes('?') ? '&' : '?') + 't=' + Date.now();
    const dl = document.getElementById('btn-download');
    if (dl) dl.href = '/download/' + encodeURIComponent(src.split('?')[0].split('/').pop());
    wrap.style.display = 'flex';
  }

  function resetGenerateBtn() {
    const btn = document.getElementById('btn-generate');
    btn.disabled = false;
    btn.style.opacity = '1';
    document.getElementById('gen-icon').textContent  = 'auto_awesome';
    document.getElementById('gen-label').textContent = 'Generate';
  }

  // ── Status polling ─────────────────────────────────────────────────────
  // Polls /status every 3s. Stops automatically on done or error.
  let pollTimer = null;

  function startPolling() {
    if (pollTimer) return;
    pollTimer = setInterval(async () => {
      try {
        const data = await fetch('/status').then(r => r.json());

        if (data.status === 'running') {
          showPlaceholder('Pushing to Kaggle...', data.message, 'cloud_upload', true, true);

        } else if (data.status === 'waiting') {
          showPlaceholder('Generating on Kaggle GPU…', data.message, 'hourglass_top', true, true);

        } else if (data.status === 'done') {
          clearInterval(pollTimer); pollTimer = null;
          resetGenerateBtn();
          if (data.image) {
            showImage(data.image);
          } else {
            // Fallback: check /last-image
            try {
              const id = await fetch('/last-image').then(r => r.json());
              if (id.image) { showImage(id.image); return; }
            } catch(_) {}
            showPlaceholder('Image ready — click Fetch', 'Press the Fetch Image button in the toolbar.', 'download', false, false);
          }

        } else if (data.status === 'error') {
          clearInterval(pollTimer); pollTimer = null;
          resetGenerateBtn();
          showPlaceholder('Error', data.message, 'error', false, false);
          document.getElementById('canvas-icon').style.color = 'rgb(239,68,68)';
        }
      } catch(_) {}
    }, 3000);
  }

  // ── Fetch Image button ────────────────────────────────────────────────
  async function fetchImageNow() {
    const btn = document.getElementById('btn-fetch');
    btn.style.opacity = '0.5';
    btn.style.pointerEvents = 'none';
    showPlaceholder('Fetching from Kaggle…', 'Downloading the latest kernel output...', 'download', true, true);
    try {
      await fetch('/fetch-now', { method: 'POST' });
      // Start polling to catch when download finishes
      if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
      startPolling();
    } catch(e) {
      showPlaceholder('Error', 'Could not reach server.', 'error', false, false);
    } finally {
      setTimeout(() => {
        btn.style.opacity = '1';
        btn.style.pointerEvents = 'auto';
      }, 3000);
    }
  }

  // ── Generate button ───────────────────────────────────────────────────
  async function handleGenerate() {
    const prompt = document.getElementById('prompt-input').value.trim();
    if (!prompt) {
      showPlaceholder('Prompt required', 'Please enter a prompt before generating.', 'warning', false, false);
      return;
    }
    // Stop any existing poll
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }

    const btn = document.getElementById('btn-generate');
    btn.disabled = true;
    btn.style.opacity = '0.7';
    document.getElementById('gen-icon').textContent  = 'sync';
    document.getElementById('gen-label').textContent = 'Submitting...';
    showPlaceholder('Submitting job…', 'Writing prompt and triggering Kaggle GPU...', 'cloud_upload', true, true);

    try {
      const res  = await fetch('/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt, ratio: selectedRatio })
      });
      const data = await res.json();
      if (data.ok) {
        document.getElementById('gen-label').textContent = 'Running...';
        startPolling();
      } else {
        showPlaceholder('Failed', data.message, 'error', false, false);
        resetGenerateBtn();
      }
    } catch(e) {
      showPlaceholder('Connection Error', 'Cannot reach local server. Is app.py running?', 'wifi_off', false, false);
      resetGenerateBtn();
    }
  }

  document.getElementById('btn-generate').addEventListener('click', handleGenerate);
  document.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') handleGenerate();
  });
</script>
</body>
</html>
